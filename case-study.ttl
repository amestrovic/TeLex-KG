# --- the regulation (its enacting text as a whole) ------------------------

<sluzbeni/2010/83/2375/whole>
    a tlx:Component ;
    eli:is_part_of <https://narodne-novine.nn.hr/eli/sluzbeni/2010/83/2375> ;
    eli:type_subdivision tlx:WholeText ;
    tlx:canonicalId "whole" ;
    rdfs:comment "The termination condition applies to the regulation as a whole, so its enacting text is represented as one component."@en .

<sluzbeni/2010/83/2375/whole/v/2010-07-13>
    a tlx:TemporalVersion ;
    eli:is_member_of <sluzbeni/2010/83/2375/whole> ;
    eli:first_date_entry_in_force "2010-07-13"^^xsd:date ;
    tlx:openEnd tlx:PendingCondition ;
    tlx:hasCondition <condition/sluzbeni/2022/151/2330/art_50/sluzbeni/2010/83/2375> ;
    eli:date_applicability "2010-07-13"^^xsd:date ;
    tlx:openApplicabilityEnd tlx:NotExtracted ;
    eli:is_realized_by <sluzbeni/2010/83/2375/whole/v/2010-07-13/hrv> ;
    rdfs:comment "Article 50 of OG 151/2022 keeps the regulation in force (ostaju na snazi). The included sources do not state whether or until when the regulation is applied after it ceases to be in force, so the end of applicability is recorded as not extracted."@en .

<sluzbeni/2010/83/2375/whole/v/2010-07-13/hrv>
    a tlx:TextUnit ;
    eli:language lang:HRV ;
